# App
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Auth.js / NextAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=studio-assets
S3_FORCE_PATH_STYLE=true

# Provider — fake (default / CI) or kie (P2-A real gateway). Never commit real keys.
# IMAGE_PROVIDER=fake
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# W2: run inspect in-process (skip BullMQ) — useful for e2e / local without worker
# INSPECT_INLINE=1

# Provider: fake only until W0-02 unblocked (never commit real keys)
IMAGE_PROVIDER=fake

# W4: run generation in-process (skip BullMQ) — e2e / local without worker
# GENERATION_INLINE=1
FAKE_WEBHOOK_SECRET=fake-webhook-secret

# W6: run QA / export in-process (skip BullMQ). INSPECT_INLINE also enables these.
# QA_INLINE=1
# EXPORT_INLINE=1

# W8: BullMQ worker concurrency + admit-time backpressure (Fake / Staging)
WORKER_CONCURRENCY=4
QUEUE_MAX_WAITING=200

# ─── P2-A: kie.ai image gateway (IMAGE_PROVIDER=kie) ─────────────────────────
# Never commit real keys. Create key at https://kie.ai/api-key
# IMAGE_PROVIDER=kie
# KIE_BASE_URL=https://api.kie.ai
# KIE_API_KEY=
# Documented Market model IDs (override only with real Market IDs from docs.kie.ai):
# KIE_MODEL_GENERATE=seedream/5-pro-text-to-image
# KIE_MODEL_EDIT=seedream/5-pro-image-to-image
# Optional webhook HMAC from kie dashboard Settings (dual channel with poll):
# KIE_WEBHOOK_HMAC_KEY=
# Budget estimate: docs example ~7 credits × $0.005/credit (kie billing UI)
# KIE_ESTIMATED_CREDITS_PER_IMAGE=7
# KIE_USD_PER_CREDIT=0.005
# Rate limit awareness (docs: ~20 creates / 10s):
# KIE_CREATE_RATE_MAX=20
# KIE_CREATE_RATE_WINDOW_MS=10000
# KIE_WORKER_CONCURRENCY_CAP=4
# PROVIDER_POLL_INTERVAL_MS=2500
# PROVIDER_MAX_POLLS=360

# ─── V2: planner agent (PLANNER_PROVIDER=kie) ────────────────────────────────
# Real LLM shot-plan planner via kie.ai — reuses the SAME KIE_API_KEY as the
# image gateway (no second key needed). kie LLM endpoint shape (docs.kie.ai/
# market/gemini/*): POST {KIE_BASE_URL}/{model}/v1/chat/completions — the model
# slug goes in the PATH (NOT the unified /api/v1/chat/completions).
# PLANNER_PROVIDER=kie
# Model slugs seen in kie Market: gemini-3-flash (verified working 2026-09-14),
# gemini-3-5-flash, gemini-3-1-pro, claude-sonnet-4-6, gpt-5-2 …
# KIE_LLM_MODEL=gemini-3-flash
# KIE_LLM_CHAT_PATH=  # optional full override, e.g. /gemini-3-flash/v1/chat/completions

# ─── V2: chat agent (CHAT_PROVIDER=kie, PR-4) ────────────────────────────────
# Canvas-operator chat agent — reuses the SAME KIE_API_KEY / KIE_BASE_URL /
# KIE_LLM_MODEL / KIE_LLM_CHAT_PATH as the planner above. Default fake
# (deterministic offline rules, no key needed).
# CHAT_PROVIDER=kie
# 参谋模式可选模型白名单（默认 Gemini 3.8 Flash + Claude Sonnet 4.6）。
# 覆盖格式：slug:中文名,slug2:中文名2
# 注意 kie 的 OpenAI 兼容 slug 带 -openai 后缀（gemini-3-8-flash-openai）；
# Claude 走 Anthropic 原生 /claude/v1/messages，slug 用 claude-sonnet-4-6。
# CHAT_MODELS=gemini-3-8-flash-openai:Gemini 3.8 Flash,claude-sonnet-4-6:Claude


# ─── PR-6: local workbench (LOCAL_MODE) ──────────────────────────────────────
# Single-user local workbench: no login wall for browsing/editing (a fixed
# local principal owns those requests). Paid actions — image generation runs,
# planner/chat LLM turns — still require a real signed-in account (login at
# /login once; 24h JWT). Default off. `pnpm dev:local` sets this plus
# INSPECT_INLINE/GENERATION_INLINE automatically.
# LOCAL_MODE=1

{
  "name": "@studio/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint stub ok (flat eslint config minimal for W1)\"",
    "test": "vitest run",
    "openapi:generate": "tsx src/openapi-generate.ts"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@studio/domain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}

// Amazon AI Image Studio — W1+W2+W3-A+W3-B1+W4+W5-A+W6 Prisma schema
// IDs: UUIDv7 generated in application code; DB type uuid.
// Times: timestamptz via Prisma DateTime (@db.Timestamptz)
// Tenancy: workspace_id on all tenant tables; composite FK (workspace_id, parent_id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  REVIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum UploadSessionStatus {
  CREATED
  UPLOADING
  UPLOADED
  INSPECTING
  READY
  REJECTED
  EXPIRED
}

enum AssetKind {
  PRODUCT_PHOTO
  REFERENCE
  MASK
  GENERATED
  OTHER
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
  ARCHIVED
}

enum AssetRepresentationKind {
  ORIGINAL_UPLOAD
  NORMALIZED_PNG
  THUMBNAIL_WEBP
  MASK_PNG
  EDITOR_PREVIEW
}

enum TruthRevisionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SUPERSEDED
}

enum FactStatus {
  EXTRACTED
  CONFIRMED
  REJECTED
  LOCKED
}

enum ConstraintKind {
  LOCK
  ALLOW
  UNKNOWN
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ShotPlanRevisionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SUPERSEDED
}

enum ShotBriefSlot {
  MAIN
  FEATURE
  DETAIL
  DIMENSION
  LIFESTYLE
  PACKAGE
}

model User {
  id             String     @id @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  name           String?
  status         UserStatus @default(ACTIVE)
  /// Bumped on password change/reset/disable to invalidate JWT sessions (ADR-0002).
  sessionVersion Int        @default(0) @map("session_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz

  accounts        Account[]
  sessions        Session[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]

  @@map("users")
}

/// Auth.js / NextAuth Account (OAuth / credentials linkage)
model Account {
  id                String  @id @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js / NextAuth Session (database strategy)
model Session {
  id           String   @id @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Tenant root — no self-referencing workspace_id
model Workspace {
  id          String    @id @db.Uuid
  name        String
  ownerUserId String    @map("owner_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  owner               User                   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members             WorkspaceMember[]
  projects            Project[]
  uploadSessions      UploadSession[]
  assets              Asset[]
  assetVersions       AssetVersion[]
  assetRepresentations AssetRepresentation[]
  masks               Mask[]
  truthDocuments      ProductTruthDocument[]
  truthRevisions      ProductTruthRevision[]
  productFacts        ProductFact[]
  productConstraints  ProductConstraint[]
  outboxMessages      OutboxMessage[]
  shotPlanDocuments   ShotPlanDocument[]
  shotPlanRevisions   ShotPlanRevision[]
  shotBriefs          ShotBrief[]
  auditEvents         AuditEvent[]
  workflows           Workflow[]
  workflowDrafts      WorkflowDraft[]
  workflowRevisions   WorkflowRevision[]
  generationRuns      GenerationRun[]
  generationItems     GenerationItem[]
  generationAttempts  GenerationAttempt[]
  providerSubmissions ProviderSubmission[]
  generationOutputs   GenerationOutput[]
  creditAccounts      CreditAccount[]
  creditLedgerEvents  CreditLedgerEvent[]
  providerCostEvents  ProviderCostEvent[]
  progressEvents      ProgressEvent[]
  nodeResults         NodeResult[]
  qaReports           QaReport[]
  qaFindings          QaFinding[]
  approvals           Approval[]
  exportBundles       ExportBundle[]
  exportBundleItems   ExportBundleItem[]

  @@index([ownerUserId])
  @@unique([id]) // enables composite FK targets (workspace_id, id)
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  sku         String
  name        String
  asin        String?
  marketplace String        @default("US")
  category    String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadSessions   UploadSession[]
  assets           Asset[]
  truthDocument    ProductTruthDocument?
  shotPlanDocument ShotPlanDocument?
  workflows        Workflow[]
  generationRuns   GenerationRun[]
  nodeResults      NodeResult[]
  qaReports        QaReport[]
  approvals        Approval[]
  exportBundles    ExportBundle[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sku])
  @@index([workspaceId, status])
  @@map("projects")
}

model UploadSession {
  id                     String              @id @db.Uuid
  workspaceId            String              @map("workspace_id") @db.Uuid
  projectId              String              @map("project_id") @db.Uuid
  assetId                String              @map("asset_id") @db.Uuid
  expectedKey            String              @map("expected_key")
  expectedMime           String              @map("expected_mime")
  expectedBytes          Int                 @map("expected_bytes")
  expectedChecksumSha256 String?             @map("expected_checksum_sha256")
  status                 UploadSessionStatus @default(CREATED)
  /// Idempotency key for complete(); unique per workspace when set.
  completionKey          String?             @map("completion_key")
  expiresAt              DateTime            @map("expires_at") @db.Timestamptz
  rejectionReason        String?             @map("rejection_reason") @db.Text
  createdByUserId        String              @map("created_by_user_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, completionKey])
  @@index([workspaceId, projectId, status])
  @@index([expiresAt])
  @@map("upload_sessions")
}

model Asset {
  id               String      @id @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  kind             AssetKind   @default(PRODUCT_PHOTO)
  status           AssetStatus @default(UPLOADING)
  currentVersionId String?     @map("current_version_id") @db.Uuid
  originalFilename String?     @map("original_filename")
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project        Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  currentVersion AssetVersion?   @relation("AssetCurrentVersion", fields: [workspaceId, currentVersionId], references: [workspaceId, id], onDelete: SetNull)
  versions       AssetVersion[]  @relation("AssetVersions")
  uploadSessions UploadSession[]

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId, status])
  @@map("assets")
}

model AssetVersion {
  id                     String   @id @db.Uuid
  workspaceId            String   @map("workspace_id") @db.Uuid
  assetId                String   @map("asset_id") @db.Uuid
  versionNumber          Int      @map("version_number")
  primaryParentVersionId String?  @map("primary_parent_version_id") @db.Uuid
  sha256                 String
  mime                   String
  width                  Int?
  height                 Int?
  colorSpace             String?  @map("color_space")
  byteSize               Int      @map("byte_size")
  metadataJson           Json     @default("{}") @map("metadata_json")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Content is immutable — no updatedAt; soft-delete only via asset.

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  asset           Asset                 @relation("AssetVersions", fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Restrict)
  primaryParent   AssetVersion?         @relation("AssetVersionParent", fields: [workspaceId, primaryParentVersionId], references: [workspaceId, id], onDelete: SetNull)
  children        AssetVersion[]        @relation("AssetVersionParent")
  currentForAssets Asset[]              @relation("AssetCurrentVersion")
  representations AssetRepresentation[]
  masks           Mask[]
  qaReports       QaReport[]
  approvals       Approval[]
  exportItems     ExportBundleItem[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, assetId, versionNumber])
  @@index([workspaceId, sha256])
  @@map("asset_versions")
}

model AssetRepresentation {
  id             String                  @id @db.Uuid
  workspaceId    String                  @map("workspace_id") @db.Uuid
  assetVersionId String                  @map("asset_version_id") @db.Uuid
  kind           AssetRepresentationKind
  storageKey     String                  @map("storage_key")
  sha256         String
  bytes          Int
  width          Int?
  height         Int?
  contentType    String                  @map("content_type")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assetVersion AssetVersion @relation(fields: [workspaceId, assetVersionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, assetVersionId, kind])
  @@index([workspaceId, assetVersionId])
  @@map("asset_representations")
}

model Mask {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  assetVersionId String   @map("asset_version_id") @db.Uuid
  strokesJson    Json     @default("[]") @map("strokes_json")
  coordinateSpace String  @default("normalized_0_1") @map("coordinate_space")
  metadataJson   Json     @default("{}") @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assetVersion AssetVersion @relation(fields: [workspaceId, assetVersionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, assetVersionId])
  @@map("masks")
}

model ProductTruthDocument {
  id                 String   @id @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  currentRevisionId  String?  @map("current_revision_id") @db.Uuid
  approvedRevisionId String?  @map("approved_revision_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project          Project                @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  currentRevision  ProductTruthRevision?  @relation("TruthCurrentRevision", fields: [workspaceId, currentRevisionId], references: [workspaceId, id], onDelete: SetNull)
  approvedRevision ProductTruthRevision?  @relation("TruthApprovedRevision", fields: [workspaceId, approvedRevisionId], references: [workspaceId, id], onDelete: SetNull)
  revisions        ProductTruthRevision[] @relation("TruthDocumentRevisions")

  @@unique([workspaceId, id])
  @@unique([workspaceId, projectId])
  @@map("product_truth_documents")
}

model ProductTruthRevision {
  id              String              @id @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  documentId      String              @map("document_id") @db.Uuid
  revision        Int
  status          TruthRevisionStatus @default(DRAFT)
  schemaVersion   Int                 @default(1) @map("schema_version")
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  document    ProductTruthDocument @relation("TruthDocumentRevisions", fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Restrict)
  currentFor  ProductTruthDocument[] @relation("TruthCurrentRevision")
  approvedFor ProductTruthDocument[] @relation("TruthApprovedRevision")
  facts       ProductFact[]
  constraints ProductConstraint[]
  shotPlans   ShotPlanRevision[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId, revision])
  @@map("product_truth_revisions")
}

model ProductFact {
  id                       String     @id @db.Uuid
  workspaceId              String     @map("workspace_id") @db.Uuid
  truthRevisionId          String     @map("truth_revision_id") @db.Uuid
  key                      String
  valueJson                Json       @map("value_json")
  confidence               Float      @default(0)
  status                   FactStatus @default(EXTRACTED)
  evidenceAssetVersionIds  Json       @default("[]") @map("evidence_asset_version_ids")
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  truthRevision ProductTruthRevision @relation(fields: [workspaceId, truthRevisionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, truthRevisionId, key])
  @@index([workspaceId, truthRevisionId])
  @@map("product_facts")
}

model ProductConstraint {
  id              String         @id @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  truthRevisionId String         @map("truth_revision_id") @db.Uuid
  kind            ConstraintKind
  path            String
  rule            String
  severity        String         @default("MUST")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  truthRevision ProductTruthRevision @relation(fields: [workspaceId, truthRevisionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, truthRevisionId, kind])
  @@map("product_constraints")
}

model OutboxMessage {
  id            String       @id @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  jobName       String       @map("job_name")
  /// Stable BullMQ jobId used for publish + recovery (e.g. inspect-<uploadId>).
  jobId         String       @unique @map("job_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([status, createdAt])
  @@map("outbox_messages")
}

model ShotPlanDocument {
  id                 String   @id @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  currentRevisionId  String?  @map("current_revision_id") @db.Uuid
  approvedRevisionId String?  @map("approved_revision_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project          Project            @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  currentRevision  ShotPlanRevision?  @relation("ShotPlanCurrentRevision", fields: [workspaceId, currentRevisionId], references: [workspaceId, id], onDelete: SetNull)
  approvedRevision ShotPlanRevision?  @relation("ShotPlanApprovedRevision", fields: [workspaceId, approvedRevisionId], references: [workspaceId, id], onDelete: SetNull)
  revisions        ShotPlanRevision[] @relation("ShotPlanDocumentRevisions")

  @@unique([workspaceId, id])
  @@unique([workspaceId, projectId])
  @@map("shot_plan_documents")
}

model ShotPlanRevision {
  id               String                 @id @db.Uuid
  workspaceId      String                 @map("workspace_id") @db.Uuid
  documentId       String                 @map("document_id") @db.Uuid
  revision         Int
  status           ShotPlanRevisionStatus @default(DRAFT)
  /// FK to the specific approved Truth Pack revision this plan is based on (MSG-003).
  truthRevisionId  String                 @map("truth_revision_id") @db.Uuid
  schemaVersion    Int                    @default(1) @map("schema_version")
  provider         String?
  modelId          String?                @map("model_id")
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?              @map("approved_at") @db.Timestamptz
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  document      ShotPlanDocument     @relation("ShotPlanDocumentRevisions", fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Restrict)
  currentFor    ShotPlanDocument[]   @relation("ShotPlanCurrentRevision")
  approvedFor   ShotPlanDocument[]   @relation("ShotPlanApprovedRevision")
  truthRevision ProductTruthRevision @relation(fields: [workspaceId, truthRevisionId], references: [workspaceId, id], onDelete: Restrict)
  briefs        ShotBrief[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId, revision])
  @@index([workspaceId, truthRevisionId])
  @@map("shot_plan_revisions")
}

model ShotBrief {
  id                 String        @id @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  shotPlanRevisionId String        @map("shot_plan_revision_id") @db.Uuid
  slot               ShotBriefSlot
  purpose            String
  orderIndex         Int           @map("order_index")
  copyJson           Json          @default("[]") @map("copy_json")
  /// Constraints + W3-08 canvas fields: must/mustNot/qaPolicy/aspectRatio/targetPixels/referencedAssetVersionIds
  constraintsJson    Json          @map("constraints_json")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  revision  ShotPlanRevision @relation(fields: [workspaceId, shotPlanRevisionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, shotPlanRevisionId, orderIndex])
  @@index([workspaceId, shotPlanRevisionId])
  @@map("shot_briefs")
}

/// Lightweight audit trail (approve/generate). Mirrors Truth approve actor fields + explicit events.
model AuditEvent {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  metadataJson Json    @default("{}") @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

model Workflow {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  name              String
  currentRevisionId String?   @map("current_revision_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project         Project            @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  currentRevision WorkflowRevision?  @relation("WorkflowCurrentRevision", fields: [workspaceId, currentRevisionId], references: [workspaceId, id], onDelete: SetNull)
  draft           WorkflowDraft?
  revisions       WorkflowRevision[] @relation("WorkflowRevisions")

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId])
  @@map("workflows")
}

/// Editable draft graph with optimistic revision_number (spec §8.4).
model WorkflowDraft {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  graphJson      Json     @map("graph_json")
  revisionNumber Int      @default(0) @map("revision_number")
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workflow  Workflow  @relation(fields: [workspaceId, workflowId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, workflowId])
  @@map("workflow_drafts")
}

/// Immutable graph snapshot used for runs (created via POST .../snapshot).
model WorkflowRevision {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  workflowId      String   @map("workflow_id") @db.Uuid
  revision        Int
  graphJson       Json     @map("graph_json")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workflow   Workflow   @relation("WorkflowRevisions", fields: [workspaceId, workflowId], references: [workspaceId, id], onDelete: Restrict)
  currentFor Workflow[] @relation("WorkflowCurrentRevision")
  generationRuns GenerationRun[]
  nodeResults    NodeResult[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, workflowId, revision])
  @@map("workflow_revisions")
}

// ─── W5-A: Node results / fingerprint / STALE ────────────────────────────────

enum NodeExecutionStatus {
  IDLE
  STALE
  BLOCKED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// Per workflow-revision node execution cache / STALE marker (spec §8.1 / §32.1–32.2).
model NodeResult {
  id                 String              @id @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  projectId          String              @map("project_id") @db.Uuid
  workflowRevisionId String              @map("workflow_revision_id") @db.Uuid
  nodeId             String              @map("node_id")
  status             NodeExecutionStatus @default(IDLE)
  inputFingerprint   String?             @map("input_fingerprint")
  staleReason        String?             @map("stale_reason") @db.Text
  staleCause         String?             @map("stale_cause")
  outputJson         Json                @default("{}") @map("output_json")
  lastAttemptId      String?             @map("last_attempt_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project          Project          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  workflowRevision WorkflowRevision @relation(fields: [workspaceId, workflowRevisionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, workflowRevisionId, nodeId])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, inputFingerprint])
  @@map("node_results")
}

// ─── W4: Model registry snapshots, runs, credits, provider events ───────────

enum GenerationRunStatus {
  DRAFT
  VALIDATING
  BLOCKED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCEL_REQUESTED
  CANCELED
}

enum GenerationItemStatus {
  DRAFT
  VALIDATING
  BLOCKED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCEL_REQUESTED
  CANCELED
  SKIPPED_DEPENDENCY
}

enum GenerationAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCEL_REQUESTED
  CANCELED
}

enum ProviderSubmissionStatus {
  PENDING
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum CreditEventType {
  GRANT
  RESERVE
  SETTLE
  REFUND
  RELEASE
  ADJUST
}

enum GenerationOutputDisposition {
  CURRENT
  SUPERSEDED
  LATE_AFTER_CANCEL
  CORRUPT
  REJECTED
  STALE
}

model ModelRegistryEntry {
  id                   String   @id @db.Uuid
  key                  String
  provider             String
  modelId              String   @map("model_id")
  displayName          String   @map("display_name")
  enabled              Boolean  @default(true)
  operationsJson       Json     @map("operations_json")
  ratiosJson           Json     @map("ratios_json")
  resolutionTiersJson  Json     @map("resolution_tiers_json")
  maxReferenceImages   Int      @map("max_reference_images")
  maxOutputs           Int      @map("max_outputs")
  supportsSeed         Boolean  @map("supports_seed")
  supportsWebhook      Boolean  @map("supports_webhook")
  pricingJson          Json     @map("pricing_json")
  configVersion        Int      @map("config_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([key])
  @@map("model_registry_entries")
}

model GenerationRun {
  id                  String              @id @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  projectId           String              @map("project_id") @db.Uuid
  workflowRevisionId  String              @map("workflow_revision_id") @db.Uuid
  scopeJson           Json                @map("scope_json")
  status              GenerationRunStatus @default(QUEUED)
  requestedByUserId   String              @map("requested_by_user_id") @db.Uuid
  budgetLimitJson     Json?               @map("budget_limit_json")
  estimateMicrounits  Int                 @default(0) @map("estimate_microunits")
  currency            String              @default("USD")
  idempotencyKey      String              @map("idempotency_key")
  confirmBudget       Boolean             @default(false) @map("confirm_budget")
  errorJson           Json?               @map("error_json")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project          Project             @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  workflowRevision WorkflowRevision    @relation(fields: [workspaceId, workflowRevisionId], references: [workspaceId, id], onDelete: Restrict)
  items            GenerationItem[]
  creditEvents     CreditLedgerEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, workflowRevisionId])
  @@map("generation_runs")
}

model GenerationItem {
  id          String               @id @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  runId       String               @map("run_id") @db.Uuid
  nodeId      String               @map("node_id")
  slot        String?
  variantId   String?              @map("variant_id") @db.Uuid
  outputIndex Int                  @default(0) @map("output_index")
  itemKey     String               @map("item_key")
  status      GenerationItemStatus @default(QUEUED)
  modelKey    String               @map("model_key")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  run       GenerationRun       @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Restrict)
  attempts  GenerationAttempt[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, itemKey])
  @@index([workspaceId, runId])
  @@map("generation_items")
}

model GenerationAttempt {
  id                String                   @id @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  itemId            String                   @map("item_id") @db.Uuid
  attemptNo         Int                      @map("attempt_no")
  idempotencyKey    String                   @map("idempotency_key")
  provider          String
  modelId           String                   @map("model_id")
  modelSnapshotJson Json                     @map("model_snapshot_json")
  requestSnapshot   Json                     @map("request_snapshot")
  inputFingerprint  String?                  @map("input_fingerprint")
  status            GenerationAttemptStatus  @default(QUEUED)
  errorClass        String?                  @map("error_class")
  errorMessage      String?                  @map("error_message") @db.Text
  autoRetryCount    Int                      @default(0) @map("auto_retry_count")
  progress          Int                      @default(0)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  item        GenerationItem       @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Restrict)
  submission  ProviderSubmission?
  outputs     GenerationOutput[]
  creditEvents CreditLedgerEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, itemId, attemptNo])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, itemId, status])
  @@map("generation_attempts")
}

model ProviderSubmission {
  id            String                   @id @db.Uuid
  workspaceId   String                   @map("workspace_id") @db.Uuid
  attemptId     String                   @map("attempt_id") @db.Uuid
  externalJobId String?                  @map("external_job_id")
  submissionKey String                   @map("submission_key")
  leaseToken    String?                  @map("lease_token")
  heartbeatAt   DateTime?                @map("heartbeat_at") @db.Timestamptz
  status        ProviderSubmissionStatus @default(PENDING)
  provider      String
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  attempt   GenerationAttempt @relation(fields: [workspaceId, attemptId], references: [workspaceId, id], onDelete: Restrict)
  costEvents ProviderCostEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, attemptId])
  @@unique([provider, submissionKey])
  @@unique([provider, externalJobId])
  @@map("provider_submissions")
}

model GenerationOutput {
  id             String                       @id @db.Uuid
  workspaceId    String                       @map("workspace_id") @db.Uuid
  attemptId      String                       @map("attempt_id") @db.Uuid
  outputIndex    Int                          @map("output_index")
  assetVersionId String?                      @map("asset_version_id") @db.Uuid
  disposition    GenerationOutputDisposition  @default(CURRENT)
  mimeType       String?                      @map("mime_type")
  byteSize       Int?                         @map("byte_size")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  attempt   GenerationAttempt @relation(fields: [workspaceId, attemptId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, attemptId, outputIndex])
  @@map("generation_outputs")
}

model ProviderEvent {
  id               String    @id @db.Uuid
  workspaceId      String?   @map("workspace_id") @db.Uuid
  provider         String
  externalEventId  String    @map("external_event_id")
  externalJobId    String?   @map("external_job_id")
  payloadHash      String    @map("payload_hash")
  payloadJson      Json      @map("payload_json")
  processedAt      DateTime? @map("processed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([provider, externalJobId])
  @@map("provider_events")
}

/// Snapshot row for quick reads; authoritative balance = fold of ledger events.
model CreditAccount {
  id                   String   @id @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  currency             String   @default("USD")
  /// Controlled snapshot — updated only inside ledger write tx after append.
  availableMicrounits  BigInt   @default(0) @map("available_microunits")
  heldMicrounits       BigInt   @default(0) @map("held_microunits")
  consumedMicrounits   BigInt   @default(0) @map("consumed_microunits")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  events    CreditLedgerEvent[]

  @@unique([workspaceId])
  @@unique([workspaceId, id])
  @@map("credit_accounts")
}

model CreditLedgerEvent {
  id              String          @id @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  type            CreditEventType
  microunits      BigInt
  idempotencyKey  String          @map("idempotency_key")
  attemptId       String?         @map("attempt_id") @db.Uuid
  runId           String?         @map("run_id") @db.Uuid
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account   CreditAccount      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict)
  attempt   GenerationAttempt? @relation(fields: [workspaceId, attemptId], references: [workspaceId, id], onDelete: SetNull)
  run       GenerationRun?     @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, accountId, createdAt])
  @@map("credit_ledger_events")
}

model ProviderCostEvent {
  id                    String   @id @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  providerSubmissionId  String   @map("provider_submission_id") @db.Uuid
  type                  String
  amountNumeric         Decimal  @map("amount_numeric") @db.Decimal(18, 8)
  currency              String
  settlementKey         String   @map("settlement_key")
  providerInvoiceLineId String?  @map("provider_invoice_line_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  submission ProviderSubmission @relation(fields: [workspaceId, providerSubmissionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([settlementKey])
  @@index([workspaceId, providerSubmissionId])
  @@map("provider_cost_events")
}

/// Thin progress events for SSE fan-out (also published on Redis).
model ProgressEvent {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  runId       String?  @map("run_id") @db.Uuid
  attemptId   String?  @map("attempt_id") @db.Uuid
  type        String
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, projectId, createdAt])
  @@map("progress_events")
}


// ─── W6: QA reports / findings / approvals / export ─────────────────────────

enum QaFindingStatus {
  PASS
  REVIEW
  FAIL
}

enum QaReportOverallStatus {
  PASS
  REVIEW
  BLOCK
}

enum QaJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  OVERRIDE_BLOCK
  REVOKE
}

enum ExportBundleStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

/// Immutable global rule-pack versions (spec §32.13).
model GlobalMarketRuleDefinition {
  id              String   @id @db.Uuid
  key             String
  version         Int
  marketplaceCode String   @map("marketplace_code")
  scopeJson       Json     @map("scope_json")
  priority        Int
  effectiveDate   DateTime @map("effective_date") @db.Date
  rulesJson       Json     @map("rules_json")
  sourceUrlsJson  Json     @map("source_urls_json")
  contentSha256   String   @map("content_sha256")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, version])
  @@map("global_market_rule_definitions")
}

model GlobalMarketRuleActivation {
  id          String   @id @db.Uuid
  key         String
  version     Int
  environment String
  enabled     Boolean  @default(true)
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz

  @@unique([key, environment])
  @@map("global_market_rule_activations")
}

model QaReport {
  id                   String                 @id @db.Uuid
  workspaceId          String                 @map("workspace_id") @db.Uuid
  projectId            String                 @map("project_id") @db.Uuid
  assetVersionId       String                 @map("asset_version_id") @db.Uuid
  slot                 String?
  shotBriefId          String?                @map("shot_brief_id") @db.Uuid
  truthRevisionId      String?                @map("truth_revision_id") @db.Uuid
  workflowRevisionId   String?                @map("workflow_revision_id") @db.Uuid
  rulePackKey          String                 @map("rule_pack_key")
  rulePackVersion      Int                    @map("rule_pack_version")
  rulePackSnapshotJson Json                   @map("rule_pack_snapshot_json")
  rulePackSha256       String                 @map("rule_pack_sha256")
  overallStatus        QaReportOverallStatus? @map("overall_status")
  status               QaJobStatus            @default(QUEUED)
  inputFingerprint     String?                @map("input_fingerprint")
  visionSnapshotJson   Json?                  @map("vision_snapshot_json")
  ocrSnapshotJson      Json?                  @map("ocr_snapshot_json")
  ocrScenario          String?                @map("ocr_scenario")
  visionScenario       String?                @map("vision_scenario")
  createdByUserId      String                 @map("created_by_user_id") @db.Uuid
  errorJson            Json?                  @map("error_json")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project      Project           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  assetVersion AssetVersion      @relation(fields: [workspaceId, assetVersionId], references: [workspaceId, id], onDelete: Restrict)
  findings     QaFinding[]
  approvals    Approval[]
  exportItems  ExportBundleItem[]

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, assetVersionId])
  @@map("qa_reports")
}

model QaFinding {
  id              String          @id @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  reportId        String          @map("report_id") @db.Uuid
  ruleId          String          @map("rule_id")
  ruleVersion     Int             @map("rule_version")
  evaluator       String
  status          QaFindingStatus
  severity        String
  nonWaivable     Boolean         @default(false) @map("non_waivable")
  score           Float?
  message         String          @db.Text
  evidenceJson    Json            @map("evidence_json")
  suggestedAction String?         @map("suggested_action") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  report    QaReport  @relation(fields: [workspaceId, reportId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, reportId, ruleId])
  @@index([workspaceId, reportId])
  @@map("qa_findings")
}

model Approval {
  id                  String           @id @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  projectId           String           @map("project_id") @db.Uuid
  assetVersionId      String           @map("asset_version_id") @db.Uuid
  qaReportId          String           @map("qa_report_id") @db.Uuid
  truthRevisionId     String           @map("truth_revision_id") @db.Uuid
  shotBriefRevisionId String?          @map("shot_brief_revision_id") @db.Uuid
  workflowRevisionId  String?          @map("workflow_revision_id") @db.Uuid
  inputFingerprint    String?          @map("input_fingerprint")
  decision            ApprovalDecision
  actorUserId         String           @map("actor_user_id") @db.Uuid
  actorRole           String           @map("actor_role")
  reason              String?          @db.Text
  decidedAt           DateTime         @default(now()) @map("decided_at") @db.Timestamptz

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project      Project            @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  assetVersion AssetVersion       @relation(fields: [workspaceId, assetVersionId], references: [workspaceId, id], onDelete: Restrict)
  qaReport     QaReport           @relation(fields: [workspaceId, qaReportId], references: [workspaceId, id], onDelete: Restrict)
  exportItems  ExportBundleItem[]

  @@unique([workspaceId, id])
  @@index([workspaceId, assetVersionId, decidedAt])
  @@index([workspaceId, qaReportId])
  @@map("approvals")
}

model ExportBundle {
  id              String             @id @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  status          ExportBundleStatus @default(QUEUED)
  sku             String
  marketplaceCode String             @map("marketplace_code")
  truthRevisionId String?            @map("truth_revision_id") @db.Uuid
  rulePackKey     String             @map("rule_pack_key")
  rulePackVersion Int                @map("rule_pack_version")
  manifestJson    Json?              @map("manifest_json")
  manifestSha256  String?            @map("manifest_sha256")
  zipStorageKey   String?            @map("zip_storage_key")
  zipSha256       String?            @map("zip_sha256")
  zipBytes        Int?               @map("zip_bytes")
  errorJson       Json?              @map("error_json")
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  items     ExportBundleItem[]

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId, createdAt])
  @@map("export_bundles")
}

model ExportBundleItem {
  id             String @id @db.Uuid
  workspaceId    String @map("workspace_id") @db.Uuid
  bundleId       String @map("bundle_id") @db.Uuid
  assetVersionId String @map("asset_version_id") @db.Uuid
  qaReportId     String @map("qa_report_id") @db.Uuid
  approvalId     String @map("approval_id") @db.Uuid
  slot           String
  variantCode    String @map("variant_code")
  path           String
  sha256         String
  bytes          Int
  mime           String
  outputIndex    Int    @default(0) @map("output_index")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bundle       ExportBundle @relation(fields: [workspaceId, bundleId], references: [workspaceId, id], onDelete: Restrict)
  assetVersion AssetVersion @relation(fields: [workspaceId, assetVersionId], references: [workspaceId, id], onDelete: Restrict)
  qaReport     QaReport     @relation(fields: [workspaceId, qaReportId], references: [workspaceId, id], onDelete: Restrict)
  approval     Approval     @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, bundleId])
  @@map("export_bundle_items")
}
